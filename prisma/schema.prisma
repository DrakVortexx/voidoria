generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  player       Player?

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Player {
  id               String        @id @default(uuid())
  userId           String        @unique @map("user_id")
  coins            Int           @default(10000)
  level            Int           @default(1)
  xp               Int           @default(0)
  dailyStreak      Int           @default(0) @map("daily_streak")
  lastDailyReward  DateTime?     @map("last_daily_reward")
  activeJob        String?       @map("active_job")
  jobStartedAt     DateTime?     @map("job_started_at")
  jobEarnedToday   Int           @default(0) @map("job_earned_today")
  jobDayReset      DateTime?     @map("job_day_reset")
  createdAt        DateTime      @default(now()) @map("created_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory        Inventory[]
  sentTrades       Trade[]       @relation("TradeSender")
  receivedTrades   Trade[]       @relation("TradeReceiver")
  auctionListings  AuctionListing[]

  @@map("players")
}

model Item {
  id          String          @id @default(uuid())
  name        String          @unique
  description String
  rarity      Rarity          @default(COMMON)
  basePrice   Int             @map("base_price")
  imageUrl    String?         @map("image_url")
  type        ItemType        @default(GENERAL)
  createdAt   DateTime        @default(now()) @map("created_at")
  inventory   Inventory[]
  shopListings ShopListing[]
  auctionListings AuctionListing[]
  tradeItems  TradeItem[]

  @@map("items")
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
  SECRET
  TRANSCENDENTAL
  OMNIVERSAL
}

enum ItemType {
  GENERAL
  WEAPON
  ARMOR
  PET
  COSMETIC
  RELIC
}

model Inventory {
  id         String   @id @default(uuid())
  playerId   String   @map("player_id")
  itemId     String   @map("item_id")
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now()) @map("acquired_at")
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemId])
  @@map("inventory")
}

model ShopListing {
  id       String   @id @default(uuid())
  itemId   String   @map("item_id")
  price    Int
  stock    Int      @default(-1)
  active   Boolean  @default(true)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("shop_listings")
}

model Trade {
  id           String   @id @default(uuid())
  senderId     String   @map("sender_id")
  receiverId   String   @map("receiver_id")
  offerCoins   Int      @default(0) @map("offer_coins")
  requestCoins Int      @default(0) @map("request_coins")
  status       TradeStatus @default(PENDING)
  createdAt    DateTime @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  sender       Player   @relation("TradeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     Player   @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  items        TradeItem[]

  @@index([senderId])
  @@index([receiverId])
  @@map("trades")
}

model TradeItem {
  id        String      @id @default(uuid())
  tradeId   String      @map("trade_id")
  itemId    String      @map("item_id")
  quantity  Int         @default(1)
  direction TradeDirection
  trade     Trade       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  item      Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("trade_items")
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum TradeDirection {
  OFFER
  REQUEST
}

model AuctionListing {
  id        String   @id @default(uuid())
  sellerId  String   @map("seller_id")
  itemId    String   @map("item_id")
  quantity  Int      @default(1)
  price     Int
  status    AuctionStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  seller    Player   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([itemId])
  @@index([status])
  @@map("auction_listings")
}

enum AuctionStatus {
  ACTIVE
  SOLD
  CANCELLED
  EXPIRED
}
