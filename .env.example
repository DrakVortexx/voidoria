DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/vaultoria?sslmode=require"
SESSION_SECRET="change-this-to-a-secure-random-string"
PORT=3000
NODE_ENV=production

# Optional: override the admin username and set an explicit admin password.
# If ADMIN_PASSWORD is unset, a strong random password is generated and logged once on first seed.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Set to "false" to skip the auto schema push on startup (recommended for production DBs you manage).
AUTO_PUSH_SCHEMA="true"