# ================= VOIDORIA (economy MMO) =================
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.

# Neon PostgreSQL connection string (serverless Postgres).
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/voidoria?sslmode=require"

# HTTP port the game server listens on.
PORT=3000

# Set to "production" when deploying. In production the server will NOT auto
# push the Prisma schema (you should apply neon_schema.sql manually).
NODE_ENV=development

# The deterministic world seed (drives region + resource-node generation).
WORLD_SEED=20260831

# Admin account username and password.
ADMIN_USERNAME="admin"
# If unset, a strong random password is generated and logged once on first seed.
ADMIN_PASSWORD=""

# Set to "false" to skip the automatic `prisma db push` on startup
# (recommended for production databases you manage yourself).
AUTO_PUSH_SCHEMA="true"
