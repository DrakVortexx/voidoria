# ================= VOIDORIA — Environment Configuration =================
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.

# Neon PostgreSQL connection string (serverless Postgres). Use the pooled or
# direct connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/voidoria?sslmode=require"

# Secret used for session/signing concerns. Generate a long random string.
#   e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-this-to-a-secure-random-string"

# HTTP port the game server listens on.
PORT=3000

# Set to "production" when deploying. In production the server will NOT auto
# push the Prisma schema (you should apply neon_schema.sql manually).
NODE_ENV=development

# The deterministic world seed. Changing this generates a brand-new world, so
# only change it on a fresh/empty database after resetting world_chunks.
WORLD_SEED=20260831

# Admin account username and password.
ADMIN_USERNAME="admin"
# If unset, a strong random password is generated and logged once on first seed.
ADMIN_PASSWORD=""

# Set to "false" to skip the automatic `prisma db push` on startup
# (recommended for production databases you manage yourself).
AUTO_PUSH_SCHEMA="true"
